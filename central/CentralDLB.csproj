<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 já vem em todo Windows 10/11: o .exe é pequeno e roda sem instalar nada antes. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CentralDLB</AssemblyName>
    <RootNamespace>CentralDlb</RootNamespace>
    <Product>Central DLB</Product>
    <AssemblyTitle>Central DLB</AssemblyTitle>
    <Company>Danilo Bonani</Company>
    <!-- publicar-central.ps1 passa -p:VersaoDLB=1.AAAAMMDD.hhmm -->
    <VersaoDLB Condition="'$(VersaoDLB)' == ''">1.0.0</VersaoDLB>
    <!-- o Windows só aceita até 65535 em cada parte da versão do .exe: a data vai no texto (InformationalVersion) -->
    <Version>1.0.0</Version>
    <InformationalVersion>$(VersaoDLB)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>icone.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="icone.ico" LogicalName="icone.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
